# HRCloudPay production environment for a single VM.
#
# Copy to `.env` in the repository root on the server:
#     cp deploy/.env.production.example .env
#     chmod 600 .env
#
# Docker Compose reads `.env` automatically. `.env` is gitignored, which is the
# only reason this file can contain a real password.

# --- REQUIRED ---------------------------------------------------------------

# Generate with:
#   python -c "from django.core.management.utils import get_random_secret_key as k; print(k())"
# settings.py refuses to boot with DEBUG=False if this is empty, "change-me",
# or the documented development value. Rotating it invalidates every session
# and every password-reset link already sent.
SECRET_KEY=

# Postgres password for the internal `db` container. Also embedded into
# DATABASE_URL by the compose file, so it must not contain characters that need
# URL-encoding (@ : / ? # & %) unless they are percent-encoded.
DB_PASSWORD=

# --- Site -------------------------------------------------------------------

# One hostname only. Serving the apex and www splits sessions, because the
# session cookie is scoped to a host.
ALLOWED_HOSTS=hrcloudpay.com
DEFAULT_FROM_EMAIL=no-reply@hrcloudpay.com

# How many reverse proxies sit in front of Django. 1 here, because Caddy is the
# only one.
#
# Left at 0, client_ip() ignores X-Forwarded-For and uses REMOTE_ADDR - which
# behind Caddy is Caddy's own Docker address. Every security session, audit row
# and the dashboard connection card then record 172.x.x.x instead of the real
# client, and the card shows its headings with nothing in them. Nothing errors;
# it just quietly describes the wrong machine.
#
# Do not raise this without counting your proxies. Set too high, a caller can
# forge their own address by prepending to the header. It is safe at 1 because
# the backend publishes no ports, so Caddy is the only way in and it rewrites
# X-Forwarded-For itself.
TRUSTED_PROXY_COUNT=1

# --- Your connection card (ISP / location / IP) -----------------------------

# Optional. Blank uses the built-in provider, https://ipwho.is/{ip}, which is
# free and needs no key - but it is someone else's free service, and the card
# goes blank without explanation when it is unreachable or rate limiting. Point
# this at IPGeolocation.io instead and it is your account's quota instead.
#
# The `{ip}` placeholder is required: the code substitutes the address into it.
# Omit it and every request resolves the same URL.
#
#   IPGeolocation.io:
#     IP_GEOLOCATION_URL=https://api.ipgeolocation.io/v3/ipgeo?apiKey=YOUR_KEY&ip={ip}
#
# Changing this needs a container recreate - environment variables are fixed
# when the container is created, so `docker compose up -d` alone will not pick
# up an edited .env.
IP_GEOLOCATION_URL=

# --- Uploaded files ---------------------------------------------------------

# Strongly recommended, and effectively required. Without a bucket, MEDIA_ROOT is
# a directory inside the container and the next rebuild destroys every employee
# document, contract, payslip attachment and knowledge-base source ever
# uploaded. The bucket should be private; hrcloudpay serves those files through
# a permission-checked view, never directly.
AWS_STORAGE_BUCKET_NAME=
AWS_S3_REGION_NAME=
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=

# --- Outbound email ---------------------------------------------------------

# The default console backend prints mail to `docker compose logs` that nobody
# reads. Activation links, password resets and invitations then vanish with no
# failure logged, and no account can be activated.
#
# Configure this to make account activation work. It can also be done later from
# Platform Admin -> PLATFORM -> Email / SMTP, which is the better place: it does
# not require a redeploy, and it stores the password encrypted at rest.
EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
EMAIL_HOST=
EMAIL_PORT=587
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
EMAIL_USE_TLS=True