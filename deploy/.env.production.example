# HRCloudPay production environment for a single VM.
#
# Copy to `.env` in the repository root on the server:
#     cp deploy/.env.production.example .env
#     chmod 600 .env
#
# Docker Compose reads `.env` automatically. `.env` is gitignored, which is the
# only reason this file can contain a real password.

# --- REQUIRED ---------------------------------------------------------------

# Generate with:
#   python -c "from django.core.management.utils import get_random_secret_key as k; print(k())"
# settings.py refuses to boot with DEBUG=False if this is empty, "change-me",
# or the documented development value. Rotating it invalidates every session
# and every password-reset link already sent.
SECRET_KEY=

# Postgres password for the internal `db` container. Also embedded into
# DATABASE_URL by the compose file, so it must not contain characters that need
# URL-encoding (@ : / ? # & %) unless they are percent-encoded.
DB_PASSWORD=

# --- Site -------------------------------------------------------------------

# One hostname only. Serving the apex and www splits sessions, because the
# session cookie is scoped to a host.
ALLOWED_HOSTS=hrcloudpay.com
DEFAULT_FROM_EMAIL=no-reply@hrcloudpay.com

# --- Uploaded files ---------------------------------------------------------

# Strongly recommended, and effectively required. Without a bucket, MEDIA_ROOT is
# a directory inside the container and the next rebuild destroys every employee
# document, contract, payslip attachment and knowledge-base source ever
# uploaded. The bucket should be private; hrcloudpay serves those files through
# a permission-checked view, never directly.
AWS_STORAGE_BUCKET_NAME=
AWS_S3_REGION_NAME=
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=

# --- Outbound email ---------------------------------------------------------

# The default console backend prints mail to `docker compose logs` that nobody
# reads. Activation links, password resets and invitations then vanish with no
# failure logged, and no account can be activated.
#
# Configure this to make account activation work. It can also be done later from
# Platform Admin -> PLATFORM -> Email / SMTP, which is the better place: it does
# not require a redeploy, and it stores the password encrypted at rest.
EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
EMAIL_HOST=
EMAIL_PORT=587
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
EMAIL_USE_TLS=True