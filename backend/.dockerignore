# Build context for the backend container.
#
# This file is needed because the backend service's build context is backend/,
# not the repository root. Docker looks for a .dockerignore next to the context
# it was given, so the root .dockerignore does not apply to this build - without
# this file `COPY . ./` sweeps in everything below, including a developer's
# local SQLite database, their uploaded files and their collected static files.
# Baking those into an image is how a set of test documents ends up published.

# Python
__pycache__/
*.py[cod]
*.so
.venv/
venv/
env/
*.egg-info/

# Local database
*.sqlite3
db.sqlite3

# Environment files - must never reach an image
.env
.env.local
.env.*.local

# Uploaded files and collected static: both are rebuilt or S3-resident.
# staticfiles/ is regenerated by collectstatic during the build.
media/
staticfiles/
frontend_dist/

# Vercel local link state
.vercel/

# Tests and tooling
htmlcov/
.coverage
.pytest_cache/

# VCS and editor
.git/
.gitignore
.vscode/
.idea/
*.swp

# OS
.DS_Store
Thumbs.db

# Not part of the backend service image
Dockerfile
docker-compose.yml
.dockerignore