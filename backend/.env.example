# Generate a long, unique secret before using DEBUG=False. Do not deploy this value.
SECRET_KEY=change-me-to-a-random-secret
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
# REQUIRED in production. The public origin of the site, and it is not a
# cosmetic setting: it builds company activation links
# (accounts/views.py, accounts/platform.py), the post-payment redirect
# (accounts/payment_services.py) and OAuth return URLs (integrations/oauth.py).
# Left at the development default, every activation email contains a link to
# localhost and no account can ever be activated. On hrcloudpay.com this is
# https://hrcloudpay.com - no trailing slash, and matching the real scheme, or
# the link a customer receives will not resolve.
FRONTEND_URL=http://localhost:5173
DEFAULT_FROM_EMAIL=no-reply@hrcloudpay.com

# ---------------------------------------------------------------------------
# SECRET_ENCRYPTION_KEYS - READ THIS BEFORE THE FIRST REAL DEPLOY
# ---------------------------------------------------------------------------
# Every third-party credential HRCloudPay stores is encrypted at rest with
# Fernet: payment provider secret keys and webhook secrets, MFA TOTP seeds,
# and integration OAuth client secrets. The key comes from this variable.
#
# Leave it empty and the key is DERIVED FROM SECRET_KEY (SHA-256 of it). That is
# fine for local work, and it is a trap in production: rotate or regenerate
# SECRET_KEY for any reason and every one of those secrets becomes permanently
# undecryptable. Payment providers cannot be re-read, MFA enrolments stop
# verifying, and connected integrations fail to refresh.
#
# So: set this explicitly, once, before storing any real credential.
#
#   python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
#
# Format: comma-separated. The FIRST key encrypts; every key in the list is
# tried when decrypting. That is what makes rotation safe - to rotate, prepend
# a new key and keep the old one:
#
#   SECRET_ENCRYPTION_KEYS=<new-key>,<previous-key>
#
# Old values stay readable, new writes use <new-key>. Once you are confident
# nothing still needs the old key, drop it from the list. Removing a key makes
# everything it encrypted unreadable, so do not prune it early.
SECRET_ENCRYPTION_KEYS=

# ---------------------------------------------------------------------------
# Database - READ THIS BEFORE THE FIRST REAL DEPLOY
# ---------------------------------------------------------------------------
# SQLite is the default and is fine for local work. It is not a production
# option: it allows a single writer, so a second worker or any concurrent
# write fails with "database is locked"; it keeps the entire database in one
# file on the machine's disk; and it cannot support the SELECT ... FOR UPDATE
# that payroll processing depends on for correctness.
#
# Set DATABASE_URL to a Postgres URL. The password may be percent-encoded if it
# contains reserved characters, and TLS is required rather than assumed:
#
#   DATABASE_URL=postgres://USER:PASSWORD@HOST:5432/DATABENAME?sslmode=require
#
# Always specify sslmode explicitly. Managed Postgres requires TLS, and leaving
# it off would send payroll data in the clear rather than failing.
DATABASE_URL=

# How long a database connection is held open between requests, in seconds.
CONN_MAX_AGE=60

# ---------------------------------------------------------------------------
# Shared cache - set in ANY deployment with more than one worker
# ---------------------------------------------------------------------------
# DRF's rate limiting keeps its counters in Django's default cache. That default
# is LocMemCache, which is private to each process, so with 4 workers the
# configured login limit of 10/minute becomes an effective 40/minute. Set this
# and the limit is counted once, centrally.
#
#   REDIS_URL=redis://redis.internal:6379/0
REDIS_URL=
CACHE_KEY_PREFIX=hrcloudpay

# ---------------------------------------------------------------------------
# Uploaded files - READ THIS BEFORE THE FIRST DEPLOY
# ---------------------------------------------------------------------------
# Without these, MEDIA_ROOT is a directory on whichever machine is running
# Django. On a container platform that directory is part of the image's
# writable layer, so EVERY DEPLOY DESTROYS every employee document, contract,
# payslip attachment and knowledge-base source uploaded since the last one. A
# disk volume stops the loss but cannot be shared with a second worker and
# still has no backup.
#
# Set the bucket name and uploads go to a private S3 bucket instead, where
# versioning, lifecycle and replication are the provider's problem.
#
#   AWS_STORAGE_BUCKET_NAME=hrcloudpay-media
#   AWS_S3_REGION_NAME=eu-west-1
#   AWS_ACCESS_KEY_ID=
#   AWS_SECRET_ACCESS_KEY=
#
# The bucket MUST stay private, and these must stay unset:
#   * do not set AWS_S3_CUSTOM_DOMAIN
#   * do not set AWS_QUERYSTRING_AUTH
# Either one hands out a bearer URL that bypasses the role check in
# serve_media for as long as the URL lives. Every object here is an identity,
# medical or disciplinary document, and they are served through an
# authenticated route that applies per-kind role rules.
#
# For a non-AWS provider (Cloudflare R2, MinIO, Backblaze) also set
# AWS_S3_ENDPOINT_URL. R2 in particular needs S3-compatible API calls rather
# than the AWS endpoints, and its own credentials rather than an IAM role.
AWS_STORAGE_BUCKET_NAME=
AWS_S3_REGION_NAME=
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_S3_ENDPOINT_URL=
# Server-side encryption at rest. HR and payroll documents are personal data,
# so this should not be turned off.
AWS_S3_SERVER_SIDE_ENCRYPTION=AES256

# ---------------------------------------------------------------------------
# Backups
# ---------------------------------------------------------------------------
# `manage.py create_backup` backs up the DATABASE only. The rows name every
# uploaded file but do not contain it, so a restore also needs the object
# storage above. The command prints this warning on every run.
#
# Back up the database and the documents together, then actually restore both
# into a scratch environment and confirm the documents open. A backup that has
# never been restored is a hypothesis, not a backup.

# ---------------------------------------------------------------------------
# Email
# ---------------------------------------------------------------------------
# Defaults to the console backend, which prints mail to stdout instead of
# sending it. Password resets, payroll notifications and statutory filing
# notices silently go nowhere unless this is set for production, e.g.:
#   EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
#   EMAIL_HOST=smtp.example.com
#   EMAIL_PORT=587
#   EMAIL_HOST_USER=
#   EMAIL_HOST_PASSWORD=
#   EMAIL_USE_TLS=True
EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend

# ---------------------------------------------------------------------------
# Integration OAuth (register apps with each provider before enabling production connections)
# ---------------------------------------------------------------------------
# The public origin of the API, used for OAuth callback URLs
# (integrations/oauth.py). Same host as FRONTEND_URL on a single-origin
# deployment; it only differs when the API is served from its own hostname.
BACKEND_PUBLIC_URL=http://localhost:8000
MICROSOFT_CLIENT_ID=
MICROSOFT_CLIENT_SECRET=
QUICKBOOKS_CLIENT_ID=
QUICKBOOKS_CLIENT_SECRET=
XERO_CLIENT_ID=
XERO_CLIENT_SECRET=
# Integration webhook signing secrets
QUICKBOOKS_WEBHOOK_VERIFIER=
XERO_WEBHOOK_KEY=

# ---------------------------------------------------------------------------
# Client IP resolution - READ THIS BEFORE DEPLOYING BEHIND A PROXY
# ---------------------------------------------------------------------------
# The dashboard's connection card shows the caller's own IP address, country and
# ISP. Where that address comes from depends on how the app is reached.
#
# TRUSTED_PROXY_COUNT = how many reverse proxies sit in front of Django
#   0  (default) Django is reached directly. REMOTE_ADDR is used and the
#      X-Forwarded-For header is ignored entirely.
#   1  one proxy (nginx, an AWS ALB, a Cloudflare Tunnel, etc.). The client
#      address is read from the right-hand end of X-Forwarded-For.
#   2  two proxies, and so on.
#
# This defaults to 0 rather than 1 ON PURPOSE: an over-count is dangerous but
# visible (you get the wrong address and can count your hops), whereas an
# under-count is silently spoofable, because a client can prepend anything to
# X-Forwarded-For and a low count would read its forged entry.
#
#   Direct local use (python manage.py runserver, opened on the same machine):
#     leave it at 0. The address is 127.0.0.1 and there is no public location to
#     show - the card says "Private network", which is accurate.
#   Behind nginx / ALB / Cloudflare on a real domain:
#     set it to the real hop count, or the card will show the load balancer's
#     address instead of the caller's.
#   Cloudflare Tunnel specifically: set 1. The tunnel forwards CF-Connecting-IP,
#     which Django also accepts via X-Real-IP when X-Forwarded-For is absent.
TRUSTED_PROXY_COUNT=0

# Optional allowlist of proxy addresses. When TRUSTED_PROXY_COUNT is 0 this is
# the only way to have X-Forwarded-For read at all; entries are comma-separated
# and matched against the immediate peer's address. Leave blank when Django is
# reached directly.
TRUSTED_PROXY_IPS=

# Optional override for the geolocation provider used by the connection card.
# It must return JSON with a country and a network operator; {ip} is replaced
# with the URL-encoded address. Leave blank for the default (ipwho.is, free and
# keyless). Both of these layouts are understood - see security/geolocation.py.
#IP_GEOLOCATION_URL=https://ipwho.is/{ip}
#
# IPGeolocation.io, if you prefer its ASN/company data. It REQUIRES an API key,
# which the vendor takes as a query parameter, so the key ends up in this value:
#IP_GEOLOCATION_URL=https://api.ipgeolocation.io/v3/ipgeo?apiKey=YOUR_KEY&ip={ip}
# Two caveats before choosing it over the keyless default:
#   * The ASN *domain* is only returned on paid plans. The free plan still gives
#     country, region, city, network operator and ASN number.
#   * The `security` block (is_vpn / is_proxy / is_tor / threat_score) is paid
#     only, needs include=security, costs 3 credits a call instead of 1, and is
#     discarded by the extractor anyway - it is not shown on the card.
# Each successful lookup costs 1 credit. The card caches per address for 24h and
# rate limits the Refresh button, so a busy month costs far less than pageviews.

# Seconds to wait on the geolocation provider. It sits on a dashboard request
# that must not hang, so keep it short; on failure the card degrades to the
# address alone rather than erroring.
IP_GEOLOCATION_TIMEOUT_SECONDS=3.0

# How often one user may force a re-lookup past the 24-hour cache by pressing
# the card's Refresh button. A cached answer is already correct for a day, so this
# is about reassurance, not accuracy - and it stops the button from being a way
# to burn the provider's quota. Set 0 to disable (self-hosted provider only).
CONNECTION_REFRESH_MIN_INTERVAL_SECONDS=30

# ---------------------------------------------------------------------------
# Sessions, request limits and transport security
# ---------------------------------------------------------------------------
# Hours a login session stays valid before it must authenticate again.
SECURITY_SESSION_HOURS=12

# Largest request body the API will read, in bytes. Uploads (employee photos,
# documents, CSV/Excel imports) go through here, so raising it raises the
# memory cost of every oversized request.
API_REQUEST_MAX_BYTES=5242880

# How long the Strict-Transport-Security header is advertised, in seconds.
# Only takes effect over HTTPS; set to 0 to omit the header entirely.
SECURE_HSTS_SECONDS=31536000

# ---------------------------------------------------------------------------
# Authentication rate limiting and step-up MFA
# ---------------------------------------------------------------------------
# Two independent limits defend the login endpoints (see SECURITY_OPERATIONS.md):
#
#   * Per-IP  - DRF's throttle, applied via each view's `throttle_scope`. Stops
#               one address spraying many accounts.
#   * Per-account - progressive lockout below. Stops many addresses hammering a
#               single account, which the per-IP layer cannot see.
#
# DRF rate strings are "<count>/<period>", e.g. 10/minute, 5/hour.
THROTTLE_LOGIN_RATE=10/minute
# A TOTP code is only 6 digits, so the MFA verify/step-up endpoints are limited
# more tightly than login to make code-stuffing impractical.
THROTTLE_MFA_RATE=8/minute
THROTTLE_PASSWORD_CHANGE_RATE=5/minute
THROTTLE_PASSWORD_RESET_RATE=5/hour

# Consecutive failed logins before an account starts being locked out. Each
# further failure lengthens the delay (30s, 60s, 5m, 15m, 1h, then held at 1h).
# A successful login clears the counter. Locked accounts return HTTP 429 with a
# generic message that does not reveal whether the account exists.
LOGIN_LOCKOUT_THRESHOLD=5

# How long a completed MFA challenge keeps satisfying step-up-protected actions
# (payroll approval/payment, salary-change approval, privileged-access approval).
# After this window the user must re-enter their code. Set to 0 to require a
# fresh code on every such action.
MFA_STEP_UP_WINDOW_SECONDS=900

# ---------------------------------------------------------------------------
# Content-Security-Policy
# ---------------------------------------------------------------------------
# The API sends a baseline CSP. Set CSP_REPORT_ONLY=True to stage a change
# without blocking anything: the browser reports violations instead of refusing
# to load the resource, so you can confirm the policy matches what the app
# actually needs before enforcing it.
#
# The default policy allows Google Fonts (the only external origin) and inline
# styles (many components set style={{...}} on elements, which strict style-src
# would blank out). It forbids eval, plugins, and framing.
#
# CSP_REPORT_URI is optional; when set, it is appended as a report-uri
# directive so browsers POST violations there.
CSP_REPORT_ONLY=False
CSP_REPORT_URI=

# ---------------------------------------------------------------------------
# Document malware scanning
# ---------------------------------------------------------------------------
# Employee document and knowledge-base uploads are scanned with ClamAV when
# enabled. Requires the clamscan binary to be installed and reachable at
# CLAMSCAN_PATH; the upload is rejected if the scan cannot run.
#
#   DOCUMENT_MALWARE_SCANNING_ENABLED  turn scanning on at all.
#   DOCUMENT_MALWARE_SCANNING_REQUIRED reject the upload when it cannot be
#                        scanned. Leave False to allow the upload unscanned
#                        while the scanner is down (fail-open).
DOCUMENT_MALWARE_SCANNING_ENABLED=False
DOCUMENT_MALWARE_SCANNING_REQUIRED=False
CLAMSCAN_PATH=clamscan

# ---------------------------------------------------------------------------
# AI (NVIDIA hosted NIM)
# ---------------------------------------------------------------------------
# No environment variables. The provider, API key, endpoints and model names
# are stored in the database and edited by the site administrator under
# Platform Admin -> AI, so the key is never exposed to tenant users or to this
# file. The default models are nvidia/nemotron-3-super-120b-a12b for chat and
# nvidia/nemotron-3-embed-1b for embeddings.
