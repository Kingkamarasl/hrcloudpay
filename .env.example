# ---------------------------------------------------------------------------
# HRCloudPay environment. Copy to `.env` for local development; for a
# deployment, set the same names as real environment variables (Railway:
# the service's Variables tab, or `railway variables set`).
#
# Every value below marked REQUIRED has no safe default. `settings.py` raises
# ImproperlyConfigured rather than booting on a production-shaped config that
# is missing SECRET_KEY, and Django falls back to SQLite when DATABASE_URL is
# absent - which on a container platform means a fresh empty database on every
# deploy, silently.
# ---------------------------------------------------------------------------

# --- Core (REQUIRED in production) -----------------------------------------

# REQUIRED. Generate with:
#   python -c "from django.core.management.utils import get_random_secret_key as k; print(k())"
# `settings.py` refuses to start with DEBUG=False if this is empty, "change-me"
# or the documented development value.
SECRET_KEY=

# REQUIRED. False everywhere except a developer's own machine. Turning this on
# serves tracebacks with source context to anyone who triggers an error.
DEBUG=False

# REQUIRED. Comma-separated hostnames. A leading dot matches the domain and any
# subdomain. For hrcloudpay.com:
#   ALLOWED_HOSTS=hrcloudpay.com
# Pick one hostname and redirect the other to it. Serving both the apex and `www`
# splits sessions and duplicates every page, because a visitor can bounce between
# them mid-session and the cookie gets set twice.
# The frontend and the API share one origin, so the frontend's hostname is not
# listed separately.
ALLOWED_HOSTS=

# REQUIRED. Postgres, not SQLite. Append `?sslmode=require` for a hosted
# database. `settings.py` refuses any non-postgres URL.
DATABASE_URL=

# REQUIRED. Must match the Postgres URL exactly, or migrations run against one
# database while the app reads another.
POSTGRES_DB=
POSTGRES_USER=
POSTGRES_PASSWORD=


# --- Cache / rate limiting (REQUIRED) --------------------------------------

# REQUIRED on any platform running more than one worker or more than one
# instance. DRF's throttle counters live in the default cache, which is
# per-process LocMemCache unless this is set. The configured login limit of
# 10/minute then silently becomes 10/minute *per worker* - a 4-worker deploy
# allows 40. Set it to a hosted Redis (Vercel KV / Upstash).
REDIS_URL=


# --- HTTPS and cookies -----------------------------------------------------

# Whether to bounce http -> https. Defaults to True when DEBUG=False, which is
# correct on a host that terminates TLS itself.
#
# Set it to False when a proxy in front of Django already terminates TLS but
# does not send X-Forwarded-Proto. With the redirect on and no such header,
# SecurityMiddleware 301s every request to a URL the client cannot follow,
# including the health checks. Behind Vercel, which does send
# X-Forwarded-Proto, the default is fine.
SECURE_SSL_REDIRECT=True


# --- Uploaded files (REQUIRED on serverless/container) ---------------------

# MEDIA_ROOT is a directory on whichever machine runs Django. On a platform
# where the filesystem is ephemeral or per-instance, every deploy destroys
# every uploaded file: employee documents, contracts, payslip attachments,
# company logos and knowledge-base sources. Set these and uploads go to
# private S3, which also makes versioning and replication the provider's
# problem rather than a backup script's.
#
# `create_backup` backs up the DATABASE only - the rows name each file but do
# not contain it. Back up the bucket too.
AWS_STORAGE_BUCKET_NAME=
AWS_S3_REGION_NAME=
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
# Optional. Required if the bucket blocks public access and policy documents
# are served through presigned URLs.
AWS_S3_CUSTOM_DOMAIN=


# --- Email -----------------------------------------------------------------

# REQUIRED. The console backend is the default, which means activation and
# password-reset emails go to the server log and never arrive.
#   EMAIL_BACKEND=django.core.mail.backends.ses.EmailBackend
EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend
DEFAULT_FROM_EMAIL=HRCloudPay <no-reply@example.com>


# --- CORS ------------------------------------------------------------------

# Only needed if a browser ever calls this API from a different origin. Under
# Vercel Services the SPA and the API share a domain, so this stays empty -
# which is the point. Setting it reopens the cross-origin cookie problem the
# single-origin deployment exists to avoid (see README, Deploying).
CORS_ALLOWED_ORIGINS=


# --- Frontend build --------------------------------------------------------

# Where the browser sends API calls. Leave unset in production: the client then
# falls back to the relative '/api', which Django serves itself - the SPA and
# the API are one service on one origin, so there is nothing to route to.
# Set it only for `npm run dev` against a local Django.
# VITE_API_URL=http://localhost:8000/api

# Release-time switches. Run in this order, against the real database:
#   python manage.py migrate --noinput
#   python manage.py seed_country_rules    # not optional, see README
#   python manage.py seed_filing_rules
#   python manage.py collectstatic --noinput
# A platform that does not run these for you (Vercel does not) needs them as an
# explicit post-deploy step; a build step that migrates would race across
# concurrent and preview builds.